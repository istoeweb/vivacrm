# Segredo usado para assinar os tokens JWT. OBRIGATÓRIO em produção.
# Gere um valor forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta do servidor (opcional, padrão 3001)
PORT=3001

# Ambiente: development | production
NODE_ENV=development

# Origens permitidas para CORS, separadas por vírgula.
# Ex.: https://vidadeouro.com.br,https://www.vidadeouro.com.br
# Deixe vazio em desenvolvimento para permitir qualquer origem.
ALLOWED_ORIGINS=

# Caminhos persistentes opcionais (recomendados no Render com Persistent Disk).
DB_PATH=
BLOG_UPLOAD_DIR=

# Supabase (opcional). Com DATABASE_URL o CRM usa o Postgres do Supabase no lugar
# do SQLite; com SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY as imagens do blog vão
# para o Supabase Storage (bucket público "blog", criado automaticamente).
# DATABASE_URL: Supabase → Connect → "Session pooler" (Render) ou
# "Transaction pooler" porta 6543 (Vercel/serverless).
# Migrar os dados de um SQLite existente: node scripts/sqlite-to-supabase.js caminho/crm.db
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Senha do admin criado pelo seed (padrão admin123) e se cria dados de exemplo.
ADMIN_PASSWORD=
SEED_DEMO=

# E-mail (aviso de lead novo). Os destinatários são configurados no CRM em
# Configurações; aqui vai só a conta que envia. Ex. Gmail: smtp.gmail.com, 587,
# seu e-mail e uma "senha de app" (myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido (opcional). Ex.: CRM Vida de Ouro <avisos@vidadeouro.com.br>
SMTP_FROM=
# URL pública usada nos links dos e-mails (opcional; padrão = domínio da requisição)
SITE_URL=
